# ── Python 虚拟环境：体积大、可重建，绝不进仓库 ──
.venv/
venv/

# ── Python 运行产物 ──
__pycache__/
*.py[cod]
*.egg-info/

# ── 运行时生成的模拟数据：脚本随时能重造，不进仓库 ──
# 注意：真实数据拿到后也放 data/，同样不进仓库（体积大 + 可能涉密）
data/*.npy
data/*.csv
data/*.mat
data/*.bin
data/*.txt

# 但保留目录本身
!data/.gitkeep

# ── 打包产物（体积大、可从源码重建，不进仓库）──
# build/dist 及调试时用的带后缀变体（dist_v2 / build_final 等）
build*/
dist*/
*.spec

# 打包日志（注意：gitignore 行内注释不生效，注释必须单独一行）
*.log

# 根目录可能残留的 exe
RD_*.exe

# 但交付版 exe 如需随仓库分发，用 git add -f 强制加入（默认不进）

# ── 编辑器 ──
.idea/
.vscode/*
!.vscode/settings.json
.DS_Store

# ⚠️ docs/images/ 里的出图成果**不忽略** —— 要 commit 进仓库，组会直接展示
